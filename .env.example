# FABRIOZA VPS environment (.env next to docker-compose.yml). NEVER commit real values.

# --- Form notification mail (Problem 2: switch to Gmail SMTP) ---
# Gmail with an App Password is the reliable route:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fabriozadotcom@gmail.com
SMTP_PASS=            # 16-char Gmail App Password (see CRM notes / handoff)
MAIL_TO=fabriozadotcom@gmail.com,sales@fabrioza.com

# --- CRM / anti-spam ---
CRM_IP_SALT=          # any long random string; makes stored IP hashes non-reversible
CRM_RATE_MAX=3        # form submissions allowed per IP per hour
RECAPTCHA_SECRET=     # reCAPTCHA v3 SECRET key (site key goes in dist/index.html)

# --- Port mapping (VPS uses 8085) ---
WEB_PORT=8085
