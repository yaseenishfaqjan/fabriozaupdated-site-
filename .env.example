# FABRIOZA VPS environment (.env next to docker-compose.yml). NEVER commit real values.

# --- Preferred sender: Resend over HTTPS (port 443) ----------------------
# Added 18 Oct 2026. The cPanel mail host firewall-banned this VPS on EVERY
# port (25/465/587/443 and ICMP) while Gmail/Office365/Resend all connected
# instantly - an LFD/cPHulk ban from repeated failed SMTP auth. Resend cannot
# be killed by an SMTP port policy and a bad key returns 401 instead of
# hammering a login until the IP is banned again.
#
# The From address does NOT change: mail still goes out as info@fabrioza.com.
# fabrioza.com must be verified in Resend as the ROOT domain, not a subdomain
# - DMARC here is adkim=s (strict), so a subdomain signature fails alignment.
# See RESEND-SETUP.md.
#
# Leave unset and behaviour is exactly as before (SMTP only).
RESEND_API_KEY=        # re_... from resend.com/api-keys (no $ to escape)
RESEND_FROM=info@fabrioza.com
RESEND_FROM_NAME=FABRIOZA

# --- Fallback: the cPanel mailbox on the veladns server ---
# (Gmail SMTP was removed 24 Sep 2026 - the App Password kept failing with
#  'Could not authenticate'. SPF + DKIM are valid for fabrioza.com on this
#  server, so mail now sends AS info@fabrioza.com with proper authentication.)
SMTP_HOST=s99.veladns.com
SMTP_PORT=465            # 465 = implicit SSL; use 587 for STARTTLS
SMTP_USER=info@fabrioza.com
SMTP_PASS=               # the info@fabrioza.com mailbox password ($ must be doubled to $$)
MAIL_TO=info@fabrioza.com,fabriozadotcom@gmail.com

# --- CRM / anti-spam ---
CRM_IP_SALT=          # any long random string; makes stored IP hashes non-reversible
CRM_RATE_MAX=3        # form submissions allowed per IP per hour
RECAPTCHA_SECRET=     # reCAPTCHA v3 SECRET key (site key goes in dist/index.html)

# --- CRM admin login (/admin) ---
ADMIN_USER=admin
ADMIN_PASS_HASH=      # bcrypt hash. IMPORTANT: docker-compose eats single $ signs,
                      # so every $ in the hash must be doubled to $$. One command does
                      # everything (generate + escape + append) - run on the VPS:
                      #   H=$(docker exec fabrioza-web php -r "echo password_hash('YOUR-PASSWORD', PASSWORD_BCRYPT);"); echo "ADMIN_PASS_HASH=${H//$/\$\$}" >> /opt/fabrioza/.env

# --- Instant lead notifications (Telegram push to your phone) ---
TELEGRAM_BOT_TOKEN=   # from @BotFather (see CRM-HANDOFF.md)
TELEGRAM_CHAT_ID=     # your chat id

# --- Port mapping (VPS uses 8085) ---
WEB_PORT=8085

# --- Inbox importer (reads the same mailbox over IMAP) ---
IMAP_HOST=s99.veladns.com
